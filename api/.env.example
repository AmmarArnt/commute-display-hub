# API Configuration
API_BASE_URL=https://transport.integration.sl.se/v1/sites
TRAFIKLAB_API_KEY=YOUR_TRAFIKLAB_SL_REALTIME_API_KEY 

# Station Configuration
STATION_SITE_ID=9531

# Filter Configuration
FILTER_LINE_NUMBER=134
FILTER_DESTINATION_NAME="Östbergahöjden"
FILTER_MAX_DEPARTURES_TO_FETCH=10
FILTER_DEPARTURES_TO_SHOW=3

# Server Port (Optional, defaults to 3000)
# PORT=3000 

# --- Optional: GTFS Regional data source (Trafiklab) instead of the SL Transport API ---
# With DATA_SOURCE=gtfs, API_BASE_URL, STATION_SITE_ID and FILTER_MAX_DEPARTURES_TO_FETCH are not needed.
# FILTER_DESTINATION_NAME is then the text shown for the destination.
# Build the timetable first: see "Using GTFS Regional realtime" in the README.
# DATA_SOURCE=gtfs
# GTFS_RT_API_KEY=YOUR_GTFS_REGIONAL_REALTIME_KEY
# GTFS_STATIC_API_KEY=YOUR_GTFS_REGIONAL_STATIC_KEY   # only used by yarn gtfs:update
# GTFS_SCHEDULE_PATH=api/data/schedule.json           # default
# GTFS_POLL_INTERVAL_MS=60000   # minimum 15000
# GTFS_MAX_STALE_MS=600000      # use last good live data this long after failures
# GTFS_IDLE_MS=300000           # stop polling this long after the last /departures request
